# ---------- Messaging API channel (LINE Developers Console) ----------
# Basic settings → Channel secret
LINE_CHANNEL_SECRET=
# Messaging API → Channel access token (long-lived) → กด Issue
LINE_CHANNEL_ACCESS_TOKEN=

# ---------- LINE Login channel (ต้องอยู่ Provider เดียวกับ Messaging API channel) ----------
# ถ้าอยู่ต่าง provider userId จะไม่ตรงกัน และเว็บแชทกับ LINE จะกลายเป็นคนละคน
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# ---------- แอป ----------
# ใช้เซ็น session cookie — สุ่มเอง เช่น `openssl rand -hex 32`
SESSION_SECRET=
# รหัสผ่านเข้าหน้า /admin
ADMIN_PASSWORD=

# ---------- ไม่บังคับ ----------
# ใส่ LINE userId ของแอดมิน ถ้าต้องการให้แจ้งเตือนเข้า LINE เมื่อมีคนทักจากเว็บแชท
ADMIN_LINE_USER_ID=
# ปล่อยว่างได้ ระบบจะเดา origin จาก header ของ request เอง
# ตั้งเมื่ออยู่หลัง proxy ที่ไม่ส่ง x-forwarded-host เช่น http://localhost:3000
NEXT_PUBLIC_BASE_URL=

# ---------- Upstash Redis ----------
# Vercel Marketplace จะใส่ KV_REST_API_URL / KV_REST_API_TOKEN ให้อัตโนมัติ
# ถ้าสมัคร Upstash เองให้ใช้สองตัวล่างนี้
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
